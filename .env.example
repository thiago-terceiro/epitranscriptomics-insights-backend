POSTGRES_USER=epi
POSTGRES_PASSWORD=epi_pass
POSTGRES_DB=epimod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_USER=your_user
RABBITMQ_PASS=your_password
RABBITMQ_HOST=your_rabbitmq_host

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=epimod

MLFLOW_TRACKING_URI=http://mlflow:5000
API_PORT=8080
JWT_SECRET=replace_me

REDIS_HOST=redis
REDIS_PORT=6379

# Toggle lightweight mocked pipeline execution (true/false)
PIPELINE_MOCK_MODE=true

# AlphaFold3 integration
ALPHAFOLD3_API_URL=
ALPHAFOLD3_API_KEY=
ALPHAFOLD3_TIMEOUT=60
ALPHAFOLD3_MOCK_MODE=true

# Collaboration settings
COLLAB_MAX_PARTICIPANTS=10
COLLAB_SESSION_TTL_SECONDS=86400

# Dorado basecaller (used by worker_dorado GPU container)
DORADO_BIN=/opt/dorado/bin/dorado
DORADO_MODEL=dna_r10.4.1_e8.2_400bps_hac@v4.3.0
DORADO_DEVICE=cuda:all

