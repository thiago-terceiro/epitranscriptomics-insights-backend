FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

# Install system dependencies for bioinformatics tools
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    curl \
    wget \
    build-essential \
    ca-certificates \
    minimap2 \
    samtools \
    pigz \
    sra-toolkit \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python deps
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN pip install --no-cache-dir m6anet

# Code (preserve package structure)
COPY services/worker /app/worker

# Switch into worker package root
WORKDIR /app/worker

# Create models directory (empty for now)
RUN mkdir -p /models /opt/cheui/scripts /opt/cheui/kmer_models /opt/cheui/CHEUI_trained_models

CMD ["celery", "-A", "tasks.celery_app", "worker", "--loglevel=INFO", "-Q", "default"]